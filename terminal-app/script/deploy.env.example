# deploy.env.example — host-specific overrides for fetch-build-deploy.sh
#
# Copy this to `deploy.env` (in this same script/ directory) ON THE DEPLOY HOST
# and fill in the real values. `deploy.env` is gitignored, so the concrete
# hostname stays out of the committed (publishable) repo.
#
#   cp script/deploy.env.example script/deploy.env
#   $EDITOR script/deploy.env
#
# fetch-build-deploy.sh sources deploy.env automatically if present.

# REQUIRED. Marks this checkout as the dedicated publish-only deploy mirror
# (e.g. ~/deploy-unified-serial-term). The script refuses to run without it, so
# it can never hard-reset a development checkout. Only the mirror gets this file.
DEPLOY_MIRROR=1

# Hostnames the deploy verifies (HTTPS 200) after publishing — one per target.
# Without them the deploy still publishes but skips the verify step.
DEPLOY_SITE_HOST=serial-lab.example.se          # `serial-lab` (staging)
DEPLOY_PROD_SITE_HOST=unified-serial.example.se # `production` (students' URL)

# --- Optional overrides (defaults shown) ---
# DEPLOY_WEBROOT=/var/www/serial-terminal
# DEPLOY_PROD_WEBROOT=/var/www/serial-terminal-production
# DEPLOY_REF=...                  # ref to deploy (usually pass as the 2nd CLI arg)
# TERMINAL_APP_DIR=/path/to/unified-serial-term/terminal-app
